{
  "name": "uiadapt-adaptive-storefront-theater",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/",
    "preview": "vite preview --host 127.0.0.1 --port 8766",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:stage": "playwright test --config=playwright.stage.config.ts",
    "stage:evidence": "node review/r12/tools/capture-stage-evidence.mjs && node review/r12/tools/measure-stage-ssim.mjs",
    "verify:build-bases": "node scripts/verify-build-bases.mjs",
    "stage:nwg": "node scripts/stage-nwg.mjs",
    "build:nwg": "npm run build && npm run stage:nwg",
    "serve:static": "serve --no-clipboard --no-port-switching --listen tcp://127.0.0.1:5173 www",
    "serve:password": "node scripts/password-gateway.mjs",
    "test:api": "node --test server/*.test.mjs",
    "test:api-integration": "node --test server/uiadapt-api.integration.test.mjs",
    "test:gateway": "node --test scripts/password-gateway.test.mjs",
    "test:deployment": "node --test scripts/nwg-deployment-contract.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "mysql2": "^3.23.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serve": "14.2.6",
    "vanilla-tilt": "1.8.1",
    "wanted-sans": "1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "pngjs": "7.0.0",
    "ssim.js": "3.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
